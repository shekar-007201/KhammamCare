rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsAppointment() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.doctor is string
        && request.resource.data.hospital is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.status == 'confirmed';

      allow read: if isAdmin() || ownsAppointment();

      allow update: if isAdmin()
        || (ownsAppointment()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'date', 'time', 'slotId', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.status in ['canceled', 'reschedule-requested']);

      allow delete: if isAdmin();
    }

    match /slotReservations/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.doctor is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.status == 'reserved';
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'canceled');
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.doctor is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emergencyFacilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
