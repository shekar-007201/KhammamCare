rules_version = '2';

service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  match /databases/{database}/documents {
    function hasAdminClaim() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }

    function isAdmin() {
      return hasAdminClaim()
        && get(/databases/$(database)/documents/privateConfig/admin).data.uid == request.auth.uid;
    }

    function isDoctor() {
      return isSignedIn()
        && request.auth.token.get('doctor', false) == true
        && request.auth.token.get('doctorName', '') is string
        && request.auth.token.get('doctorName', '').size() > 0
        && exists(/databases/$(database)/documents/privateConfig/admin/doctors/$(request.auth.uid))
        && get(/databases/$(database)/documents/privateConfig/admin/doctors/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/privateConfig/admin/doctors/$(request.auth.uid)).data.doctorName
          == request.auth.token.doctorName;
    }

    function isAssignedDoctor(doctorName) {
      return isDoctor() && doctorName == request.auth.token.doctorName;
    }

    function isPatient() {
      return isSignedIn()
        && request.auth.token.get('admin', false) != true
        && request.auth.token.get('accountType', '') != 'doctor'
        && request.auth.token.get('doctor', false) != true;
    }

    match /privateConfig/{configId} {
      allow read, write: if false;
    }

    match /privateConfig/{configId}/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow create: if isPatient()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'patient';
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isAdmin()
        || (isPatient()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == 'patient'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isPatient()
        && request.resource.data.keys().hasOnly([
          'uid',
          'appointmentToken',
          'amount',
          'paymentMode',
          'paymentStatus',
          'paymentProvider',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'appointmentToken',
          'amount',
          'paymentMode',
          'paymentStatus',
          'paymentProvider',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.appointmentToken is string
        && request.resource.data.amount == 399
        && request.resource.data.paymentMode in ['UPI', 'Card', 'Net Banking']
        && request.resource.data.paymentStatus == 'demo-paid'
        && request.resource.data.paymentProvider == 'demo'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isPatient()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'age', 'hospital', 'doctor', 'date', 'time',
          'reason', 'amount', 'paymentMode', 'paymentStatus', 'payment',
          'paymentProvider', 'token', 'status', 'createdAt', 'bookedAt', 'userEmail'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'phone', 'age', 'hospital', 'doctor', 'date', 'time',
          'amount', 'paymentMode', 'paymentStatus', 'payment',
          'paymentProvider', 'token', 'status', 'createdAt', 'bookedAt', 'userEmail'
        ])
        && request.resource.data.status == 'confirmed'
        && request.resource.data.amount == 399
        && request.resource.data.paymentMode in ['UPI', 'Card', 'Net Banking']
        && request.resource.data.paymentStatus == 'demo-paid'
        && request.resource.data.paymentProvider == 'demo';

      allow read: if isAdmin()
        || isAssignedDoctor(resource.data.doctor)
        || (isPatient() && resource.data.uid == request.auth.uid);

      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in [
            'Pending', 'confirmed', 'Approved', 'Seen', 'Rejected', 'Completed', 'canceled'
          ]
        ) || (
          isAssignedDoctor(resource.data.doctor)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Approved', 'Seen', 'Rejected', 'Completed']
        ) || (
          isPatient()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'date', 'time', 'rating', 'status'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'canceled')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating'])
            || (request.resource.data.rating is int
              && request.resource.data.rating >= 1
              && request.resource.data.rating <= 5))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['date'])
            || request.resource.data.date is string)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['time'])
            || request.resource.data.time is string)
        );

      allow delete: if false;
    }
  }
}